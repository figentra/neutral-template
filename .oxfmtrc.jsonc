// Stackra file contract:
// Purpose: oxfmt settings for the whole repository: 100 columns, Markdown prose wrapped at the same width,
//          JSONC without trailing commas, and the files `fflow sync` renders, which are never reformatted.
// Boundary: formatter options and ignores only; adding an ignore pattern needs a reason beside it.
// Runtime: node
// Governing contract: Stackra ADR 0007 (docblocks wrap at the same width); Stackra ADR 0528
{
  "$schema": "https://unpkg.com/oxfmt@0.71.0/configuration_schema.json",
  "printWidth": 100,
  "overrides": [
    {
      // Editors' JSON-with-comments services warn on a trailing comma; JSONC files carry none.
      "files": ["**/*.jsonc"],
      "options": { "trailingComma": "none" }
    },
    {
      // Prose wraps at printWidth, so the 100-column rule holds for docs too.
      "files": ["**/*.md", "**/*.mdx"],
      "options": { "proseWrap": "always" }
    }
  ],
  "ignorePatterns": [
    // rendered by `fflow sync`; .flow/lock.json pins their bytes (`fflow gate ci` fails on a reformatted file)
    ".agents/**",
    ".claude/settings.json",
    ".opencode/**",
    ".github/workflows/fflow-*.yml",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    ".mcp.yaml",
    "lefthook.yml",
    "opencode.jsonc",
    ".flow/lock.json",
    "**/node_modules/**"
  ]
}
