// Stackra file contract:
// Purpose: Renovate's dependency updates for the pinned tools (mise.toml) and the GitHub actions, grouped
//          and scheduled, never auto-merged.
// Boundary: update policy only.
// Runtime: none
// Governing contract: Stackra ADR 0019 (supply-chain hardening), Stackra ADR 0027 (tools in mise)
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:best-practices", "helpers:pinGitHubActionDigestsToSemver"],
  branchPrefix: "renovate/",
  semanticCommits: "enabled",
  semanticCommitType: "chore",
  semanticCommitScope: "deps",
  labels: ["dependencies"],
  minimumReleaseAge: "1 day",
  internalChecksFilter: "strict",
  automerge: false,
  vulnerabilityAlerts: { minimumReleaseAge: null, labels: ["dependencies", "security"] },
  packageRules: [
    {
      matchManagers: ["mise", "nodenv"],
      groupName: "toolchain",
    },
    {
      matchManagers: ["github-actions"],
      groupName: "github actions",
      schedule: ["before 6am on monday"],
    },
  ],
}
